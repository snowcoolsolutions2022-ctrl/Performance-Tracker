// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Technician {
  id          Int             @id @default(autoincrement())
  name        String
  designation String          // "INSTALL TEAM", "SERVICE TEAM", "MULTI"
  reports     MonthlyReport[]
}

model MonthlyReport {
  id             Int    @id @default(autoincrement())
  technicianId   Int
  technician     Technician @relation(fields: [technicianId], references: [id])
  month          String
  year           Int
  
  // Shared Metrics from reports
  allocatedCalls Float    @default(0.0)
  week1          Float    @default(0.0)
  week2          Float    @default(0.0)
  week3          Float    @default(0.0)
  week4          Float    @default(0.0)
  week5          Float    @default(0.0)
  totalCompleted Float    @default(0.0)
  workingDays    Int      @default(0)
  completedAverage Float @default(0.0)
  attendedAverage  Float @default(0.0)
  completedConversion Float @default(0.0)
  pendingCalls     Float @default(0.0)

  // Specific Data Relations
  installDetail     InstallDetail?
  serviceCategories ServiceCategoryBreakdown[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([technicianId, month, year])
}

model InstallDetail {
  id              Int           @id @default(autoincrement())
  reportId        Int           @unique
  report          MonthlyReport @relation(fields: [reportId], references: [id])

  // Material Details
  stand           Float   @default(0.0)
  standFixing     Float   @default(0.0)
  copperPipe      Float   @default(0.0)
  copperPipeFixing Float   @default(0.0)
  cottonRoll      Float   @default(0.0)
  stabilizer      Float   @default(0.0)
  
  // Target
  amcTarget       Float   @default(0.0)
  amcAchieved     Float   @default(0.0)
  
  // Call Breakdown
  installCount    Int   @default(0)
  reinstallCount  Int   @default(0)
  dismantleCount  Int   @default(0)
}

model ServiceCategoryBreakdown {
  id           Int           @id @default(autoincrement())
  reportId     Int
  report       MonthlyReport @relation(fields: [reportId], references: [id])
  
  categoryName String        // "HOOPERWASH", "GAS LEAK", "SERVICE/BRK", etc.
  inWarranty   Int           @default(0)
  outWarranty  Int           @default(0)
  total        Int           @default(0)
}

model InstallMonthlySummary {
  id           Int      @id @default(autoincrement())
  month        String
  year         Int
  installQty   Int      @default(0)
  reinstallQty Int      @default(0)
  dismantleQty Int      @default(0)

  // Report Headers & Titles
  table1Title  String?
  table2Title  String?
  table3Title  String?
  headers      Json?    // Stores object like { t1: string[], t2: string[], t3: string[], t3Rows: string[] }

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([month, year])
}

model ServiceMonthlySummary {
  id            Int      @id @default(autoincrement())
  month         String
  year          Int
  
  // Report Headers & Titles
  table1Title   String?
  categoryTitle String?
  headers       Json?    // Stores object like { t1: string[] }

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([month, year])
}
